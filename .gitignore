# Compiled bytecode — regenerate with ./build.sh compile
bin/
*.class

# Runtime output: receipts, binary ledger, serialized state, import files
data/

# build.sh scratch file
.sources.txt

# Eclipse workspace metadata.
# .settings/org.eclipse.jdt.core.prefs IS committed on purpose: it pins the
# compiler compliance level so the project imports the same way on any machine.
.metadata/
.settings/*
!.settings/org.eclipse.jdt.core.prefs
!.settings/org.eclipse.core.resources.prefs

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json*
